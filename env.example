# Copy to .env and fill in values.
# Never commit .env to source control.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_explorer

# Where to cache raw downloaded files (avoids re-downloading on every run)
DATA_RAW_DIR=./data/raw

# Set to 1 to force re-download even if cached file exists
FORCE_DOWNLOAD=0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
